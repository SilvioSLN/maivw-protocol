# ============================================
# MAIVW Core — Exemplo de Variáveis de Ambiente
# ============================================

# Porta e Host do Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0

# Domínio Raiz e Roteamento
MAIVW_CORE_DOMAIN=maivw.org
PLATFORM_INGRESS_HOSTS=

# Banco de Dados e Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maivw_reputation?schema=public
REDIS_URL=redis://localhost:6379

# Conexão Blockchain (EVM)
CHAIN_ID=31337
RPC_URL=http://localhost:8545
REGISTRY_CONTRACT_ADDRESS=

# Segredos de Criptografia e Autenticação (Altere em Produção!)
JWT_SECRET=substitua_por_um_jwt_secret_forte_e_aleatorio
MASTER_SECRET_KEY=substitua_por_uma_chave_aes256_aleatoria
INTERNAL_SERVICE_KEY=substitua_por_uma_chave_de_servico_forte

# Modo do Assinante do Oráculo ('local' com chave privada ou 'gcp-kms' com HSM em nuvem)
ORACLE_SIGNER_TYPE=local
# ORACLE_PRIVATE_KEY=0x... (ou configure GCP_KMS_KEY_VERSION)
# GCP_KMS_KEY_VERSION=
# GCP_KMS_CREDENTIALS_BASE64=

# URL e Token do Juiz de IA Remoto (Opcional - caso utilize cluster de IA dedicado)
# ORACLE_AI_JUDGE_URL=https://ai-judge.seudominio.com/api/v1/judge
# ORACLE_AI_JUDGE_TOKEN=

# Provedor SMTP / Legado (Opcional para envio externo fora do protocolo)
# RESEND_API_KEY=
# LEGACY_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# 5.1 FEDERAÇÃO P2P, ONBOARDING E ORÁCULO REMOTO (Self-Hosted vs. Cloud)
# ------------------------------------------------------------------------------
# IS_CLOUD: false para nós self-hosted open-source (ativa modo dual Relayer/Web3); true para nuvem Maivw oficial
IS_CLOUD=false

# URL do Oráculo Canônico / Relayer da Maivw para validação de DNS e laudos ECDSA EIP-712
# Em nós locais (Máquina B), o Gateway consulta o oráculo central (Máquina A) para emitir o voucher
MAIVW_ORACLE_URL=https://api-test.maivw.com

# Padrão de Inbound P2P Endpoint para recebimento de mensagens diretas de outros nós
# (se não configurado, o padrão sugerido é https://mw-p2p.<dominio>/api/v1/inbox)
# DEFAULT_P2P_ENDPOINT=https://mw-p2p.{domain}/api/v1/inbox
