# Overrides opcionais da demonstração local.
# O comando `docker compose up -d --build` funciona sem criar este arquivo.
# Estes valores são públicos e nunca devem ser usados em Testnet ou produção.

MAIVW_DOCKER_NETWORK=maivw-protocol-local-network
MAIVW_ENVIRONMENT=local
MAIVW_RUNTIME_ROLE=all-in-one
QUEUE_DRIVER=bullmq
STORAGE_DRIVER=filesystem
ATTACHMENTS_DIR=data/attachments
POSTGRES_PASSWORD=postgres
ADMIN_REGISTRATION_TOKEN=local-demo-admin-invite-change-before-testnet-2026
JWT_SECRET=local-demo-jwt-secret-change-before-testnet-2026
MASTER_SECRET_KEY=local-demo-master-key-change-before-testnet-2026
INTERNAL_SERVICE_KEY=local-demo-internal-key-change-before-testnet-2026

NEXT_PUBLIC_GATEWAY_URL=http://localhost:51443
NEXT_PUBLIC_WEBMAIVW_URL=http://localhost:52443
NEXT_PUBLIC_RPC_URL=http://localhost:55443
NEXT_PUBLIC_DEFAULT_ORIGIN_NETWORK=base

# Multichain/Solana permanece desabilitado na demonstração local por padrão.
MULTICHAIN_RELAY_ENABLED=false
SOLANA_ENABLED=false

# Para Testnet, não adapte este arquivo. Use `.env.testnet.example` e
# `compose.testnet.yml`, que exigem os dados da rede e segredos próprios.

# Optional separated worker routing. Leave empty for Community all-in-one.
# In ECS host-network use http://127.0.0.1:3101 (mail), :3102 (oracle), :3103 (relayer).
# In Docker bridge networking use service DNS names, never host loopback.
MAIL_WORKER_INTERNAL_URL=
ORACLE_WORKER_INTERNAL_URL=
RELAYER_WORKER_INTERNAL_URL=
WORKER_PROXY_TIMEOUT_MS=15000
WORKER_PROXY_BODY_LIMIT_BYTES=1048576
# Explicit platform operator allowlist; a tenant admin is not an oracle operator.
ORACLE_OPERATOR_EMAILS=

# Real durable consumers are opt-in after integration testing/migrations.
MAIL_QUEUE_CONSUMER_ENABLED=false
ORACLE_QUEUE_CONSUMER_ENABLED=false
RELAYER_QUEUE_CONSUMER_ENABLED=false
# Explicit deployment start block; adjust to the registry deployment before enabling an EVM indexer.
EVM_OBSERVER_START_BLOCK=0
EVM_OBSERVER_MAX_BLOCKS=200
EVM_OBSERVER_POLL_INTERVAL_MS=5000
EVM_ORIGIN_PROFILE_MODE=CURRENT
# The EVM relayer must have its own configured signer; never reuse oracle/deployer automatically.
# RELAYER_EVM_KMS_KEY_ID=alias/your-relayer-evm-signer
# RELAYER_EVM_PRIVATE_KEY is allowed only outside Cloud, through private runtime configuration.
