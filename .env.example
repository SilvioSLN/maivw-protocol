# MAIVW — piloto em Base Sepolia. Nunca use credenciais reais neste arquivo.
# Copie para .env e preencha os campos obrigatórios antes de iniciar o Gateway.
# O Compose carrega este arquivo no Gateway e sobrescreve os hosts de banco/Redis.
GATEWAY_PORT=51443
GATEWAY_HOST=0.0.0.0
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:53443/maivw_reputation?schema=public
REDIS_URL=redis://localhost:54443

# Rede e endereço do PROXY de um Registry existente ou implantado por você.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
REGISTRY_CONTRACT_ADDRESS=
BASE_RPC_URL=https://sepolia.base.org
BASE_REGISTRY_ADDRESS=

# Obrigatórios: gere cada segredo separadamente com openssl rand -hex 32.
# Cadastros administrativos ficam fechados sem este convite (mínimo 32 caracteres).
# Gere com openssl rand -hex 32, compartilhe fora do site e remova após cadastrar.
ADMIN_REGISTRATION_TOKEN=
JWT_SECRET=
MASTER_SECRET_KEY=
INTERNAL_SERVICE_KEY=

# Obrigatória no modo local: chave EVM válida, 0x + 64 caracteres hex.
# Não é JWT_SECRET. Deve corresponder ao oráculo autorizado para atestar localmente.
ORACLE_SIGNER_TYPE=local
ORACLE_PRIVATE_KEY=
# Alternativa: ORACLE_SIGNER_TYPE=gcp-kms e a versão de uma chave compatível.
# GCP_KMS_KEY_VERSION=
# GCP_KMS_CREDENTIALS_BASE64=
ORACLE_MIN_BALANCE_WEI=10000000000000000
MAIVW_ORACLE_URL=https://api-test.maivw.com
IS_CLOUD=false

# Identidade e endpoint HTTPS concreto deste nó, sem placeholder {domain}.
SENDER_DOMAIN=example.com
MAIVW_CORE_DOMAIN=example.com
PLATFORM_INGRESS_HOSTS=
DEFAULT_P2P_ENDPOINT=https://mail.example.com/api/v1/inbox
# COMPANY_A_PRIVATE_KEY= (fallback de assinatura; prefira carteiras por domínio)
# DEPLOYER_PRIVATE_KEY= (somente quando executar scripts de deploy)

# Opcionais: saída SMTP, recebimento legado e juiz remoto.
# RESEND_API_KEY=
# LEGACY_WEBHOOK_SECRET=
# ORACLE_AI_JUDGE_URL=
# ORACLE_AI_JUDGE_TOKEN=
# ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ARBITRUM_REGISTRY_ADDRESS=
# POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGON_REGISTRY_ADDRESS=

# Endereços acessíveis pelo NAVEGADOR. Mudanças exigem novo build Next.js.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:51443
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=
# Login Google é opcional. Configure projeto e credenciais próprios antes de usá-lo.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json
