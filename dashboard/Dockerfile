FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json next.config.mjs ./
COPY public/ public/
COPY src/ src/
COPY scripts/ scripts/

# Build-time env vars
ARG MAIVW_ENVIRONMENT=local
ARG NEXT_PUBLIC_GATEWAY_URL=http://localhost:51443
ARG NEXT_PUBLIC_DASHBOARD_URL=http://localhost:50443
ARG NEXT_PUBLIC_WEBMAIVW_URL=http://localhost:52443
ARG NEXT_PUBLIC_RPC_URL=http://localhost:55443
ARG NEXT_PUBLIC_CHAIN_ID=31337
ARG NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=
ARG NEXT_PUBLIC_PAYMENT_API_URL=

ENV MAIVW_ENVIRONMENT=$MAIVW_ENVIRONMENT
ENV NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL
ENV NEXT_PUBLIC_DASHBOARD_URL=$NEXT_PUBLIC_DASHBOARD_URL
ENV NEXT_PUBLIC_WEBMAIVW_URL=$NEXT_PUBLIC_WEBMAIVW_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=$NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS
ENV NEXT_PUBLIC_PAYMENT_API_URL=$NEXT_PUBLIC_PAYMENT_API_URL

RUN pnpm run build

ENV NODE_ENV=production
EXPOSE 3000

USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1

CMD ["pnpm", "run", "start"]
