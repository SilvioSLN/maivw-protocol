        { "name": "admin_key", "type": { "defined": { "name": "maivw_registry::state::KeyDescriptor" } } },
        { "name": "endpoint", "type": "string" }, { "name": "tls_fingerprint", "type": { "array": ["u8", 32] } },
        { "name": "status", "type": { "defined": { "name": "maivw_registry::state::DomainStatus" } } },
