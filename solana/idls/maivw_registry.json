        { "name": "domain_hash", "type": { "array": ["u8", 32] } }, { "name": "mint", "type": "pubkey" },
        { "name": "token_account", "type": "pubkey" }, { "name": "original_registration_amount", "type": "u64" },
        { "name": "current_stake", "type": "u64" }
