datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OriginNetworkFamily {
  EVM
  SOLANA
}

enum OriginRecordStatus {
  ACTIVE
}

enum OriginAuditAction {
  ORIGIN_ACTIVATED
  ORIGIN_RECONCILED
}

enum OriginOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OriginDnsChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum OriginRegistrantAlgorithm {
  SECP256K1_EVM
  ED25519_SOLANA
}

enum OriginReservationStatus {
  RESERVED
  CLAIM_ISSUED
  CONSUMED
  EXPIRED
  CANCELLED
}

enum OriginClaimStatus {
  ISSUED
  SUBMITTED
  CONSUMED
  EXPIRED
}

enum OriginReservationAuditAction {
  RESERVATION_CREATED
  CLAIM_ISSUED
  RESERVATION_EXPIRED
}

enum EvmObservationStatus {
  FINALIZED
  ORPHANED
}

enum MultichainRelayStatus {
  DETECTED
  FINALIZED
  ATTESTED
  SUBMITTED
  CONFIRMED
  RECONCILE
}

enum MultichainRelayOperation {
  REGISTER
  SYNC
  REVOKE
}

enum RelaySubmissionStatus {
  PREPARED
  BROADCAST
  CONFIRMED
}

enum RelaySubmissionAttemptOutcome {
  BROADCAST
  RETRY_SCHEDULED
  CONFIRMED
}

/// Cursor durável por Registry EVM. nextBlock só avança na mesma transação que
/// persiste o bloco e todos os eventos reconhecidos nele.
model EvmObserverCursor {
  networkId           String   @id
  networkName         String
  chainId             BigInt   @unique
  registryAddress     String   @db.Char(42)
  registryId          String   @db.Char(66)
  confirmations       Int
  startBlock          BigInt
  nextBlock           BigInt
  lastProcessedBlock  BigInt?
  lastProcessedHash   String?  @db.Char(66)
  observedHead        BigInt?
  finalizedHead       BigInt?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  blocks EvmObservedBlock[]
  events EvmSourceEvent[]
}

/// Mantém também as ramificações órfãs para auditoria de reorg.
model EvmObservedBlock {
  id          String               @id @default(uuid())
  networkId   String
  blockNumber BigInt
  blockHash   String               @db.Char(66)
  parentHash  String               @db.Char(66)
  status      EvmObservationStatus @default(FINALIZED)
  observedAt  DateTime             @default(now())
  orphanedAt  DateTime?

  cursor EvmObserverCursor @relation(fields: [networkId], references: [networkId], onDelete: Restrict)

  @@unique([networkId, blockNumber, blockHash])
  @@index([networkId, status, blockNumber])
}

/// Evento de origem EVM finalizado e idempotente por posição canônica no bloco.
model EvmSourceEvent {
  id               String               @id @default(uuid())
  networkId        String
  registryId       String               @db.Char(66)
  blockNumber      BigInt
  blockHash        String               @db.Char(66)
  transactionHash  String               @db.Char(66)
  transactionIndex Int
  logIndex          Int
  eventName         String
  domainHash        String?              @db.Char(66)
  payload           Json
  status            EvmObservationStatus @default(FINALIZED)
  observedAt        DateTime             @default(now())
  orphanedAt        DateTime?

  cursor EvmObserverCursor @relation(fields: [networkId], references: [networkId], onDelete: Restrict)

  @@unique([networkId, blockHash, transactionHash, logIndex])
  @@index([networkId, status, blockNumber, transactionIndex, logIndex])
  @@index([domainHash, status])
}

/// Cursor Solana ancorado exclusivamente em commitment finalized.
model SolanaObserverCursor {
  networkId     String   @id
  programId     String   @unique
  commitment    String
  startSlot     BigInt
  lastSlot      BigInt?
  lastSignature String?
  observedSlot  BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions SolanaObservedTransaction[]
  events       SolanaSourceEvent[]
}

model SolanaObservedTransaction {
  id          String   @id @default(uuid())
  networkId   String
  slot        BigInt
  signature   String
  blockTime   DateTime?
  observedAt  DateTime @default(now())

  cursor SolanaObserverCursor @relation(fields: [networkId], references: [networkId], onDelete: Restrict)

  @@unique([networkId, signature])
  @@index([networkId, slot])
}

model SolanaSourceEvent {
  id               String   @id @default(uuid())
  networkId        String
  programId        String
  slot             BigInt
  signature        String
  instructionIndex Int
  logIndex         Int
  eventName        String
  domainHash       String?  @db.Char(66)
  payload          Json
  observedAt       DateTime @default(now())

  cursor SolanaObserverCursor @relation(fields: [networkId], references: [networkId], onDelete: Restrict)

  @@unique([networkId, signature, instructionIndex, logIndex])
  @@index([networkId, slot, signature])
  @@index([domainHash, slot])
}

/// Unidade durável de trabalho produzida por um evento de origem. Cada job
/// possui um destino independente por deployment de mirror.
model MultichainRelayJob {
  id                    String                    @id @default(uuid())
  sourceEventKey        String                    @unique
  domainHash            String                    @db.Char(66)
  operation             MultichainRelayOperation
  originNetworkFamily   OriginNetworkFamily
  originNetworkId       String
  originRegistryId      String                    @db.Char(66)
  sourceTransactionId   String
  sourcePosition        String
  globalDomainEpoch     BigInt
  originSequence        BigInt
  status                MultichainRelayStatus     @default(DETECTED)
  sourceStateHash       String?                   @db.Char(66)
  detectedAt            DateTime
  finalizedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  destinations MultichainRelayDestination[]
  transitions  MultichainRelayTransition[]

  @@index([domainHash, globalDomainEpoch, originSequence])
  @@index([status, updatedAt])
}

model MultichainRelayDestination {
  id                       String                @id @default(uuid())
  jobId                    String
  destinationNetworkFamily OriginNetworkFamily
  destinationNetworkId     String
  destinationRegistryId    String                @db.Char(66)
  status                   MultichainRelayStatus @default(DETECTED)
  attestationDigest        String?               @db.Char(66)
  submissionId             String?
  confirmationReference    String?
  reconcileReference       String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  job         MultichainRelayJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  transitions MultichainRelayTransition[]
  submission  MultichainRelaySubmission?

  @@unique([jobId, destinationNetworkId, destinationRegistryId])
  @@index([status, updatedAt])
}

/// Payload já assinado e imutável. Retries retransmitem estes mesmos bytes,
/// preservando nonce/signature e portanto o mesmo transaction id.
model MultichainRelaySubmission {
  id                    String                @id @default(uuid())
  destinationId         String                @unique
  idempotencyKey        String                @unique
  signedPayload         String
  signedPayloadHash     String                @db.Char(66)
  expectedTransactionId String
  deadline              DateTime
  status                RelaySubmissionStatus @default(PREPARED)
  attempts              Int                   @default(0)
  leaseOwner            String?
  leaseUntil            DateTime?
  nextAttemptAt         DateTime
  lastError             String?
  submittedAt           DateTime?
  confirmedAt           DateTime?
  finalityReference     String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  destination MultichainRelayDestination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  attemptsLog MultichainRelaySubmissionAttempt[]

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
}

model MultichainRelaySubmissionAttempt {
  id             String                        @id @default(uuid())
  submissionId   String
  attempt        Int
  workerId       String
  outcome        RelaySubmissionAttemptOutcome
  transactionId  String?
  finalityRef    String?
  error          String?
  createdAt      DateTime                      @default(now())

  submission MultichainRelaySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, attempt, outcome])
  @@index([submissionId, createdAt])
}

/// Histórico append-only das transições; o estado materializado nunca é a
/// única evidência de avanço do relayer.
model MultichainRelayTransition {
  id            String                @id @default(uuid())
  jobId         String
  destinationId String?
  fromStatus    MultichainRelayStatus?
  toStatus      MultichainRelayStatus
  artifactHash  String?               @db.Char(66)
  reference     String?
  reason        String?
  createdAt     DateTime              @default(now())

  job         MultichainRelayJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  destination MultichainRelayDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([destinationId, createdAt])
}

/// Fonte transacional para a rede de origem imutável de cada domainHash.
/// A unicidade global é deliberadamente independente da tabela Domain de produto.
model OriginRecord {
  id                  String              @id @default(uuid())
  domainHash          String              @unique @db.Char(66)
  domain              String
  originNetworkFamily OriginNetworkFamily
  originNetworkId     String
  originNetworkHash   String              @db.Char(66)
  originRegistryId    String              @db.Char(66)
  originVersion       Int                 @default(1)
  status              OriginRecordStatus  @default(ACTIVE)
  originTxFamily      OriginNetworkFamily
  originTxId          String
  globalDomainEpoch   BigInt
  originSequence      BigInt
  activatedAt         DateTime
  lastReconciledAt    DateTime?
  lastAuditHash       String              @db.Char(66)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  auditEvents OriginAuditEvent[]

  @@index([originNetworkId, status])
}

/// Ledger append-only do catálogo. Não possui updatedAt e não deve ser mutado
/// ou removido; cada hash inclui o hash do evento anterior do mesmo domínio.
model OriginAuditEvent {
  id                String            @id @default(uuid())
  ordinal           BigInt            @unique @default(autoincrement())
  originRecordId    String
  domainHash        String            @db.Char(66)
  action            OriginAuditAction
  previousState     Json?
  nextState         Json
  actorType         String
  actorIdHash       String?           @db.Char(66)
  requestId         String
  previousEventHash String?           @db.Char(66)
  eventHash         String            @unique @db.Char(66)
  createdAt         DateTime          @default(now())

  originRecord OriginRecord       @relation(fields: [originRecordId], references: [id], onDelete: Restrict)
  outboxEvent  OriginOutboxEvent?

  @@unique([domainHash, requestId])
  @@index([domainHash, createdAt])
}

/// Evento durável produzido atomicamente com cada entrada de auditoria.
/// O worker pode atualizar somente o estado de publicação desta tabela.
model OriginOutboxEvent {
  id           String             @id @default(uuid())
  auditEventId String             @unique
  topic        String
  partitionKey String
  payload      Json
  status       OriginOutboxStatus @default(PENDING)
  attempts     Int                @default(0)
  availableAt  DateTime           @default(now())
  lastError    String?
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())

  auditEvent OriginAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([partitionKey, createdAt])
}

/// Desafio de posse que não bloqueia o domínio. Segredos são persistidos somente como hash.
model OriginDnsChallenge {
  id                  String                   @id @default(uuid())
  domainHash          String                   @db.Char(66)
  domain              String
  requesterId         Int
  originNetworkFamily OriginNetworkFamily
  originNetworkId     String
  originNetworkHash   String                   @db.Char(66)
  originRegistryId    String                   @db.Char(66)
  registrantAlgorithm OriginRegistrantAlgorithm
  registrantKey       String                   @db.Char(66)
  tokenHash           String                   @db.Char(66)
  contextHash         String                   @db.Char(66)
  dnsValueHash        String                   @db.Char(66)
  status              OriginDnsChallengeStatus @default(PENDING)
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime                 @default(now())

  reservation OriginReservation?

  @@index([domainHash, status, expiresAt])
  @@index([requesterId, createdAt])
}

/// Bloqueio temporário e atômico da escolha de origem.
/// blockingDomainHash permanece igual ao domainHash enquanto a reserva bloqueia;
/// ao expirar/cancelar vira null, explorando a semântica UNIQUE de null no PostgreSQL.
model OriginReservation {
  id                  String                    @id @default(uuid())
  domainHash          String                    @db.Char(66)
  blockingDomainHash  String?                   @unique @db.Char(66)
  domain              String
  dnsChallengeId      String                    @unique
  requesterId         Int
  originNetworkFamily OriginNetworkFamily
  originNetworkId     String
  originNetworkHash   String                    @db.Char(66)
  originRegistryId    String                    @db.Char(66)
  registrantAlgorithm OriginRegistrantAlgorithm
  registrantKey       String                    @db.Char(66)
  dnsEvidenceHash     String                    @db.Char(66)
  nonce               String                    @unique @db.Char(66)
  status              OriginReservationStatus   @default(RESERVED)
  idempotencyKeyHash  String                    @db.Char(66)
  requestHash         String                    @db.Char(66)
  expiresAt           DateTime
  claimDeadline       DateTime?
  holdUntil           DateTime
  lastAuditHash       String                    @db.Char(66)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  dnsChallenge OriginDnsChallenge              @relation(fields: [dnsChallengeId], references: [id], onDelete: Restrict)
  claim        OriginClaimIssuance?
  auditEvents  OriginReservationAuditEvent[]

  @@unique([requesterId, idempotencyKeyHash])
  @@index([domainHash, status, holdUntil])
}

/// OriginClaimV1 assinado. Um reservationId e um nonce só podem produzir uma emissão.
model OriginClaimIssuance {
  id                 String            @id @default(uuid())
  reservationId      String            @unique
  domainHash         String            @db.Char(66)
  codecVersion       Int               @default(1)
  encoded            String            @db.VarChar(586)
  digest             String            @unique @db.Char(66)
  signedBytesHash    String            @db.Char(66)
  signature          String
  signerKeyId        String
  signerKeyVersion   String
  nonce              String            @unique @db.Char(66)
  deadline           DateTime
  payloadHash        String            @db.Char(66)
  evidenceHash       String            @db.Char(66)
  idempotencyKeyHash String            @unique @db.Char(66)
  requestHash        String            @db.Char(66)
  status             OriginClaimStatus @default(ISSUED)
  submittedAt        DateTime?
  consumedAt         DateTime?
  onChainTxFamily    OriginNetworkFamily?
  onChainTxId        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  reservation OriginReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([domainHash, status, deadline])
}

/// Histórico imutável das transições que bloqueiam a escolha de origem.
model OriginReservationAuditEvent {
  id                String                       @id @default(uuid())
  ordinal           BigInt                       @unique @default(autoincrement())
  reservationId     String
  domainHash        String                       @db.Char(66)
  action            OriginReservationAuditAction
  previousState     Json?
  nextState         Json
  actorType         String
  actorIdHash       String?                      @db.Char(66)
  requestId         String
  previousEventHash String?                      @db.Char(66)
  eventHash         String                       @unique @db.Char(66)
  createdAt         DateTime                     @default(now())

  reservation OriginReservation               @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  outboxEvent OriginReservationOutboxEvent?

  @@unique([reservationId, requestId])
  @@index([domainHash, ordinal])
}

model OriginReservationOutboxEvent {
  id           String             @id @default(uuid())
  auditEventId String             @unique
  topic        String
  partitionKey String
  payload      Json
  status       OriginOutboxStatus @default(PENDING)
  attempts     Int                @default(0)
  availableAt  DateTime           @default(now())
  lastError    String?
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())

  auditEvent OriginReservationAuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([partitionKey, createdAt])
}

/// Reputação granular por domínio e sub-identidade (Fase 7)
model Reputation {
  id              Int       @id @default(autoincrement())
  domain          String
  subIdentityId   String    @default("default")
  reputationScore Int       @default(100)
  isBlocked       Boolean   @default(false)
  strikes         Int       @default(0)
  lastViolation   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([domain, subIdentityId])
}

/// Usuário cadastrado no ecossistema MAIVW (Fase 10)
model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  displayName      String?
  role             String    @default("user") // "admin" | "user"
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  domains          Domain[]
}

/// Domínio corporativo de um usuário (Fase 10)
model Domain {
  id          Int          @id @default(autoincrement())
  domainName  String       @unique
  userId      Int
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys     ApiKey[]
  walletVault WalletVault?
  smtpConfig  SmtpConfig?
  accounts    EmailAccount[]
}

/// Chave de API para autenticação de microsserviços do desenvolvedor (Fase 10)
model ApiKey {
  id          Int       @id @default(autoincrement())
  keyHash     String    @unique
  domainId    Int
  name        String
  environment String    @default("production")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  domain      Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

/// Cofre de chaves Web3 (KMS Mock com criptografia simétrica AES-256-GCM) (Fase 10)
model WalletVault {
  id                  Int      @id @default(autoincrement())
  domainId            Int      @unique
  publicKey           String
  encryptedPrivateKey String
  iv                  String
  authTag             String
  createdAt           DateTime @default(now())

  domain              Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

/// Configuração SMTP por domínio (provedor externo: Resend, SendGrid, SES)
model SmtpConfig {
  id                Int      @id @default(autoincrement())
  domainId          Int      @unique
  provider          String   @default("resend") // "resend" | "sendgrid" | "ses"
  encryptedApiKey   String
  iv                String
  authTag           String
  fromName          String   @default("MAIVW")
  fromEmail         String?
  isActive          Boolean  @default(true)
  lastTestedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  domain            Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

/// Contas de e-mail vinculadas a um domínio (criadas pelo admin)
model EmailAccount {
  id          Int      @id @default(autoincrement())
  localPart   String                             // "contato", "suporte", etc.
  domainId    Int
  userId      Int?                               // Vinculado a um User para login
  displayName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([localPart, domainId])
}

/// Mensagens recebidas na caixa de entrada (Web3 e Legadas) (Fases 10 e 11)
model Message {
  id          Int      @id @default(autoincrement())
  messageId   String   @unique
  from        String
  to          String
  subject     String
  body        String
  msgClass    String
  status      String   @default("received")
  signature   String?
  isLegacy    Boolean  @default(false)
  isRead      Boolean  @default(false)
  isRevoked   Boolean  @default(false)                   // Sinaliza revogação on-chain pós-entrega
  revocationReason String?                               // Motivo da revogação (ex: Tag Spoofing ban)
  domainId    Int?                               // Domínio ao qual a mensagem pertence
  receivedAt  DateTime @default(now())
}

/// Rota Privada Out-of-Band para envio a Dark Endpoints (Modo Stealth)
model PrivateRoute {
  id                 Int      @id @default(autoincrement())
  targetDomain       String   @unique
  privateEndpointUrl String
  stealthToken       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Configuração do Modo de Segurança / Stealth do domínio receptor
model StealthConfig {
  id                 Int      @id @default(autoincrement())
  domainName         String   @unique
  mode               String   @default("public") // "public" | "hybrid" | "dark"
  isStealthEnabled   Boolean  @default(false)
  inboundToken       String?  // Token exigido no header x-maivw-stealth-token
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Pool / Cluster Regional de Endpoints P2P (Gestão pela Plataforma MAIVW)
model EndpointPool {
  id          Int               @id @default(autoincrement())
  code        String            @unique // ex: "sa-east-1", "us-east-1", "default", "vip-providers"
  name        String            // ex: "Cluster América do Sul (São Paulo)"
  description String?
  region      String?           @default("GLOBAL") // "BR", "US", "EU", "GLOBAL"
  isDefault   Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  nodes       EndpointNode[]
  domainRules DomainRouteRule[]
}

/// Nó / Instância de Gateway receptor dentro de um Pool P2P
model EndpointNode {
  id             Int          @id @default(autoincrement())
  poolId         Int
  name           String       // ex: "Gateway GRU-01 Primário"
  endpointUrl    String       // ex: "https://node-gru-1.maivw.internal/api/v1/inbox"
  weight         Int          @default(100) // Peso para Weighted Round-Robin (ex: 70, 30)
  isActive       Boolean      @default(true) // Toggle administrativo
  isHealthy      Boolean      @default(true) // Status do Circuit Breaker
  failureCount   Int          @default(0)    // Falhas consecutivas de entrega/healthcheck
  lastFailure    DateTime?
  lastChecked    DateTime?
  responseTimeMs Int?         // Métrica de latência observada
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pool           EndpointPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

/// Regra de roteamento atribuída pela plataforma (mapeia padrões de domínio a pools)
model DomainRouteRule {
  id            Int          @id @default(autoincrement())
  domainPattern String       @unique // ex: "itau.com.br", "*.gov.br", ou domínio específico
  poolId        Int
  priority      Int          @default(0) // Maior prioridade avaliada primeiro
  isActive      Boolean      @default(true)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  pool          EndpointPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
}
