{
  "name": "@maivw/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MAIVW Gateway H\u00edbrido \u2014 Backend Fastify",
  "main": "dist/runtime.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts all-in-one",
    "dev:gateway-api": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts gateway-api",
    "dev:p2p-ingress": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts p2p-ingress",
    "dev:mail-worker": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts mail-worker",
    "dev:oracle-worker": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts oracle-worker",
    "dev:relayer-worker": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts relayer-worker",
    "dev:evm-indexer": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts evm-indexer",
    "dev:solana-indexer": "node --env-file-if-exists=../.env --import tsx --watch src/runtime.ts solana-indexer",
    "build": "tsc",
    "start": "node dist/runtime.js all-in-one",
    "start:gateway-api": "node dist/runtime.js gateway-api",
    "start:p2p-ingress": "node dist/runtime.js p2p-ingress",
    "start:mail-worker": "node dist/runtime.js mail-worker",
    "start:oracle-worker": "node dist/runtime.js oracle-worker",
    "start:relayer-worker": "node dist/runtime.js relayer-worker",
    "start:evm-indexer": "node dist/runtime.js evm-indexer",
    "start:solana-indexer": "node dist/runtime.js solana-indexer",
    "evm:deploy:mirror-v2": "node --env-file-if-exists=../../.env --import tsx scripts/deploy-evm-mirror-v2.ts",
    "testnet:e2e:sm080": "node --env-file-if-exists=../../.env --env-file-if-exists=../.env.testnet --import tsx scripts/run-sm080-testnet-e2e.ts",
    "test:sm081": "node --import tsx scripts/run-sm081-concurrency-reorg-restart.ts",
    "test:sm082": "node --env-file-if-exists=../.env.testnet --import tsx scripts/run-sm082-operational-metrics.ts",
    "test:sm083": "node --import tsx scripts/run-sm083-ci-verifications.ts",
    "test:sm084": "node --import tsx scripts/run-sm084-security-audit-report.ts",
    "test:sm085": "node --import tsx scripts/run-sm085-deploy-manifest-publish.ts",
    "test:sm086": "node --import tsx scripts/run-sm086-multichain-canary.ts",
    "test:sm087": "node --import tsx scripts/run-sm087-golive-slo.ts",
    "test:sm088": "node --import tsx scripts/run-sm088-doc-demo-check.ts",
    "solana:init:registry": "node --env-file-if-exists=../.env.testnet --import tsx scripts/initialize-solana-registry.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check": "node --import tsx scripts/check-migration-policy.ts",
    "kms:address": "node --import tsx scripts/resolve-aws-kms-address.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@google-cloud/kms": "^6.2.1",
    "@aws-sdk/client-kms": "^3.920.0",
    "@prisma/client": "^5.22.0",
    "@solana/web3.js": "^1.98.4",
    "@aws-sdk/client-sesv2": "^3.920.0",
    "asn1.js": "^5.4.1",
    "bullmq": "^5.52.3",
    "fastify": "^5.3.3",
    "firebase-admin": "^14.4.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.4.1",
    "nodemailer": "^10.0.11",
    "resend": "^6.28.1",
    "uuid": "^11.1.0",
    "viem": "^2.30.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
