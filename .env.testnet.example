# Copie para .env.testnet e substitua todos os campos CHANGE_ME.
# Nunca use as chaves públicas de demonstração do Anvil em Testnet.

MAIVW_DOCKER_NETWORK=maivw-protocol-testnet-network
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Base Sepolia. RPC, chain ID e proxy precisam pertencer à mesma rede.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
REGISTRY_CONTRACT_ADDRESS=CHANGE_ME_0x_PROXY_ADDRESS
BASE_RPC_URL=https://sepolia.base.org
BASE_WS_URL=wss://sepolia.base.org
BASE_REGISTRY_ADDRESS=CHANGE_ME_0x_PROXY_ADDRESS
BASE_MIRROR_REGISTRY_V2_ADDRESS=CHANGE_ME_0x_BASE_MIRROR_ADDRESS
MIRROR_REGISTRY_V2_ADDRESS=CHANGE_ME_0x_BASE_MIRROR_ADDRESS

# Deployments EVM opcionais; configure Registry + RPC + WS como um conjunto.
# ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ARBITRUM_WS_URL=wss://CHANGE_ME_ARBITRUM_WS
# ARBITRUM_REGISTRY_ADDRESS=CHANGE_ME_0x_ARBITRUM_MIRROR_ADDRESS
# ARBITRUM_MIRROR_REGISTRY_V2_ADDRESS=CHANGE_ME_0x_ARBITRUM_MIRROR_ADDRESS
# POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGON_WS_URL=wss://CHANGE_ME_POLYGON_WS
# POLYGON_REGISTRY_ADDRESS=CHANGE_ME_0x_POLYGON_MIRROR_ADDRESS
# POLYGON_MIRROR_REGISTRY_V2_ADDRESS=CHANGE_ME_0x_POLYGON_MIRROR_ADDRESS

# Para ativar Solana, preencha todos os campos. O keypair deve ser montado como
# segredo; nunca inclua seu conteúdo neste arquivo versionado.
MULTICHAIN_RELAY_ENABLED=false
SOLANA_ENABLED=false
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=wss://api.devnet.solana.com
# SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
# SOLANA_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
# SOLANA_EXPLORER_URL=https://explorer.solana.com
# SOLANA_EXPLORER_CLUSTER_QUERY=cluster=devnet
# SOLANA_COMMITMENT=finalized
# SOLANA_ASSET_KIND=SPL
# SOLANA_ASSET_SYMBOL=MAIVW
# SOLANA_ASSET_DECIMALS=9
# SOLANA_ASSET_MINT=11111111111111111111111111111111111111111111
# SOLANA_STANDARD_FEE_BASE_UNITS=1000000
# SOLANA_RELAYER_PUBLIC_KEY=CHANGE_ME_RELAYER_PUBLIC_KEY
# SOLANA_RELAYER_KEYPAIR_PATH=/run/secrets/solana-relayer.json
# Usadas somente pelo script idempotente de inicialização do Registry.
# SOLANA_GUARDIAN_KEYPAIR_PATH=/run/secrets/solana-guardian.json
# SOLANA_TREASURY_KEYPAIR_PATH=/run/secrets/solana-treasury.json
# SOLANA_FOUNDER_KEYPAIR_PATH=/run/secrets/solana-founder.json
# SOLANA_REORG_MARGIN_SLOTS=64
# SOLANA_OBSERVER_PAGE_SIZE=100
# SOLANA_OBSERVER_MAX_PAGES=10
# RELAY_ATTESTATION_TTL_SECONDS=900
# RELAY_LEASE_SECONDS=60
# RELAY_FAILURE_THRESHOLD=3

# Gere quatro valores diferentes com: openssl rand -hex 32
ADMIN_REGISTRATION_TOKEN=CHANGE_ME_ADMIN_INVITE
JWT_SECRET=CHANGE_ME_JWT_SECRET
MASTER_SECRET_KEY=CHANGE_ME_MASTER_SECRET
INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_SERVICE_SECRET

# A chave deve pertencer ao oracleNode configurado no Registry e ter ETH de teste.
DEPLOYER_PRIVATE_KEY=CHANGE_ME_0x_DEPLOYER_PRIVATE_KEY
ORACLE_SIGNER_TYPE=local
ORACLE_PRIVATE_KEY=CHANGE_ME_0x_ORACLE_PRIVATE_KEY
ORACLE_MIN_BALANCE_WEI=10000000000000000
# Para KMS, remova ORACLE_PRIVATE_KEY, use ORACLE_SIGNER_TYPE=gcp-kms e preencha:
# GCP_KMS_KEY_VERSION=
# GCP_KMS_CREDENTIALS_BASE64=

SENDER_DOMAIN=example.com
MAIVW_CORE_DOMAIN=example.com
DEFAULT_P2P_ENDPOINT=https://mail.example.com/api/v1/inbox
PLATFORM_INGRESS_HOSTS=

# URLs públicas vistas pelo navegador. Use HTTPS quando o nó não estiver em localhost.
NEXT_PUBLIC_GATEWAY_URL=https://gateway.example.com
NEXT_PUBLIC_WEBMAIVW_URL=https://mail.example.com
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Login Google opcional, com um projeto Firebase do operador.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
