# ============================================
# MAIVW Core — Git Ignore
# ============================================

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.testnet.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build Outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Smart Contracts (Foundry)
broadcast/
cache/
artifacts/
solana/target/

# Credentials, Keys & Certificates
keys/
*.pem
*.key
*.p8
*.crt
*.pfx
service-account*.json
*-firebase.json

# Logs & Temporary Files
.vscode/
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Test Coverage
coverage/
.nyc_output/

# Runtime data and private backups
/data/
/backups/
/discart/

# Operator deployments & local execution evidence (keep *.example.json templates only)
contracts/deployments/*.json
!contracts/deployments/*.example.json
solana/deployments/*.json
!solana/deployments/*.example.json
evidence/
